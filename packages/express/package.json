{
  "name": "@routeui/express",
  "version": "0.1.0",
  "description": "Express middleware for RouteUI interactive API documentation explorer",
  "license": "MIT",
  "author": "Yashwanth N",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yashwanth-N17/RouteUI.git"
  },
  "keywords": [
    "express",
    "middleware",
    "swagger",
    "docs",
    "routeui"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@routeui/core": "workspace:*",
    "@routeui/ui": "workspace:*"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  }
}
